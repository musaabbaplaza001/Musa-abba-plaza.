<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Musa Abba Plaza</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f7f6;
      color: #222;
      line-height: 1.6;
    }

    header {
      background: #0b6b3a;
      color: white;
      padding: 45px 20px;
      text-align: center;
    }

    header h1 {
      font-size: 38px;
      margin-bottom: 10px;
    }

    header p {
      font-size: 18px;
    }

    .container {
      max-width: 1000px;
      margin: auto;
      padding: 30px 20px;
    }

    .welcome {
      background: white;
      padding: 30px;
      border-radius: 15px;
      margin-bottom: 25px;
      text-align: center;
      box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    }

    .welcome h2 {
      color: #0b6b3a;
      margin-bottom: 10px;
    }

    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-top: 25px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 15px;
      text-align: center;
      box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    }

    .card h3 {
      color: #0b6b3a;
      margin-bottom: 10px;
    }

    .contact {
      background: #0b6b3a;
      color: white;
      padding: 30px 20px;
      margin-top: 30px;
      border-radius: 15px;
      text-align: center;
    }

    .contact h2 {
      margin-bottom: 15px;
    }

    .button {
      display: inline-block;
      margin: 8px;
      padding: 12px 20px;
      border-radius: 8px;
      text-decoration: none;
      color: white;
      font-weight: bold;
      background: #222;
    }

    .whatsapp {
      background: #25D366;
    }

    footer {
      text-align: center;
      padding: 20px;
      margin-top: 25px;
      background: #222;
      color: white;
    }
  </style>
</head>

<body>

  <header>
    <h1>MUSA ABBA PLAZA</h1>
    <p>Your Trusted Business Centre in Bajoga</p>
  </header>

  <main class="container">

    <section class="welcome">
      <h2>Welcome to Musa Abba Plaza</h2>
      <p>
        We provide quality products and services for our customers.
        Visit us today and experience reliable service.
      </p>
    </section>

    <section class="services">

      <div class="card">
        <h3>Provision Shop</h3>
        <p>Quality everyday goods and household provisions.</p>
      </div>

      <div class="card">
        <h3>Vet Agro</h3>
        <p>Veterinary and agricultural products and services.</p>
      </div>

      <div class="card">
        <h3>Barbing Salon</h3>
        <p>Modern and professional barbing services.</p>
      </div>

    </section>

    <section class="contact">
      <h2>Contact Us</h2>

      <p>📞 Call: 09025251886</p>
      <p>💬 WhatsApp: 07026439523</p>

      <a class="button" href="tel:09025251886">
        Call Us
      </a>

      <a class="button whatsapp"
         href="https://wa.me/2347026439523"
         target="_blank">
        WhatsApp Us
      </a>

      <p style="margin-top:20px;">
        📍 Near Bajoga Satellite Prison,<br>
        Opposite Muhammadu Mai Doya Guest Palace
      </p>
    </section>

  </main>

  <footer>
    © 2026 Musa Abba Plaza. All Rights Reserved.
  </footer>

</body>
  </html>
